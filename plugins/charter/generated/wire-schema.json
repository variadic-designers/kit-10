{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WireSchemaRoot",
  "type": "object",
  "properties": {
    "box_node": {
      "$ref": "#/$defs/BoxData"
    },
    "img_node": {
      "$ref": "#/$defs/ImgData"
    },
    "shape_node": {
      "$ref": "#/$defs/ShapeData"
    },
    "text_node": {
      "$ref": "#/$defs/TextData"
    }
  },
  "required": [
    "box_node",
    "text_node",
    "img_node",
    "shape_node"
  ],
  "$defs": {
    "AlignValue": {
      "description": "CSS `align-items` / `align-self` (taffy's `AlignItems`).",
      "type": "string",
      "enum": [
        "Start",
        "End",
        "FlexStart",
        "FlexEnd",
        "Center",
        "Baseline",
        "Stretch"
      ]
    },
    "BoxData": {
      "description": "A box - a pure container. It never renders inline text; nest a `Text` child for that.",
      "type": "object",
      "properties": {
        "bg_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_width": {
          "type": "number",
          "format": "float"
        },
        "corner_radius": {
          "type": "number",
          "format": "float"
        },
        "extra": {
          "$ref": "#/$defs/BoxExtra",
          "default": {
            "align_content": null,
            "align_items": null,
            "align_self": null,
            "flex_basis": null,
            "flex_grow": 0.0,
            "flex_shrink": null,
            "flex_wrap": "NoWrap",
            "gap": 0.0,
            "grid_auto_columns": [],
            "grid_auto_flow": "Row",
            "grid_auto_rows": [],
            "grid_column": [
              "Auto",
              "Auto"
            ],
            "grid_row": [
              "Auto",
              "Auto"
            ],
            "grid_template_areas": [],
            "grid_template_columns": [],
            "grid_template_rows": [],
            "justify_content": null,
            "justify_items": null,
            "justify_self": null,
            "margin": 0.0,
            "position": "Relative"
          }
        },
        "flex_direction": {
          "$ref": "#/$defs/FlexDir"
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "description": "Independent from `selected`.",
          "type": "boolean",
          "default": false
        },
        "max_height": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "max_width": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "min_height": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "min_width": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "padding": {
          "description": "`[top, right, bottom, left]`.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "parent_id": {
          "description": "Index into the `Vec<UiNode>` of this node's parent; `None` = root.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "description": "0 = none, 1 = secondary, 2 = primary/active. The renderer owns how it's drawn - it must\nNOT overload `border_*` to signal selection.",
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoxShadow"
            },
            {
              "type": "null"
            }
          ]
        },
        "show_border": {
          "type": "boolean"
        },
        "squircle": {
          "description": "`true` renders corners as a superellipse (\"squircle\") instead of a circular arc, at\nthe same `corner_radius`. Box-shadow blur always stays circular-arc regardless - see\n`BoxShadow`'s own doc note.",
          "type": "boolean",
          "default": false
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "padding",
        "bg_color",
        "flex_direction",
        "show_border",
        "border_color",
        "border_width",
        "corner_radius",
        "opacity"
      ]
    },
    "BoxExtra": {
      "description": "Extended flex/grid layout properties, grouped so `BoxData` needn't name every field. Every\nfield is optional - an absent `extra` is all-defaults.",
      "type": "object",
      "properties": {
        "align_content": {
          "description": "Container-level `align-content` - distribution of extra space among grid tracks on the\nblock axis. `None` = taffy default (Stretch). Distinct from `align_items`, which\npositions a track's own content within the track.",
          "anyOf": [
            {
              "$ref": "#/$defs/JustifyValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "align_items": {
          "description": "Cross-axis alignment of children (`align-items`). `None` = taffy default (Stretch).",
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "align_self": {
          "description": "Per-child `align-self` override.",
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flex_basis": {
          "description": "`flex-basis`. `None` = `auto`; a \"Fill\" item wants `Px(0)` for a pure share of free space.",
          "anyOf": [
            {
              "$ref": "#/$defs/Extent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flex_grow": {
          "description": "`flex-grow`. 0 = don't grow.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "flex_shrink": {
          "description": "`flex-shrink`. `None` = taffy default (1.0).",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "flex_wrap": {
          "description": "`flex-wrap`.",
          "$ref": "#/$defs/FlexWrapValue",
          "default": "NoWrap"
        },
        "gap": {
          "description": "Uniform gap between children (`gap`), flex and grid.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "grid_auto_columns": {
          "description": "`grid-auto-columns`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_auto_flow": {
          "description": "`grid-auto-flow`.",
          "$ref": "#/$defs/GridAutoFlow",
          "default": "Row"
        },
        "grid_auto_rows": {
          "description": "`grid-auto-rows`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_column": {
          "description": "Item column placement `(start, end)`.",
          "type": "array",
          "default": [
            "Auto",
            "Auto"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GridLine"
            },
            {
              "$ref": "#/$defs/GridLine"
            }
          ]
        },
        "grid_row": {
          "description": "Item row placement `(start, end)`.",
          "type": "array",
          "default": [
            "Auto",
            "Auto"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GridLine"
            },
            {
              "$ref": "#/$defs/GridLine"
            }
          ]
        },
        "grid_template_areas": {
          "description": "`grid-template-areas` - named regions, resolved to numeric line coordinates.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GridTemplateArea"
          }
        },
        "grid_template_columns": {
          "description": "`grid-template-columns`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_template_rows": {
          "description": "`grid-template-rows`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "justify_content": {
          "description": "Main-axis distribution (`justify-content`). `None` = taffy default (Start).",
          "anyOf": [
            {
              "$ref": "#/$defs/JustifyValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "justify_items": {
          "description": "Container-level `justify-items` (grid's inline-axis default for items). `None` = taffy\ndefault (Stretch). No flex analog - flex has no separate justify-items concept.",
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "justify_self": {
          "description": "Per-item `justify-self` override - the grid analog of `align_self` on the inline axis.",
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "margin": {
          "description": "Uniform `margin` (all four sides).",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "position": {
          "description": "`position` - flow (`Relative`) vs. floated (`Absolute { x, y }`).",
          "$ref": "#/$defs/NodePosition",
          "default": "Relative"
        }
      }
    },
    "BoxShadow": {
      "description": "A drop shadow (`box-shadow`). Always blurs against a circular-arc corner, even when the\nowning `BoxData`/`TextData.squircle` is `true` - an exact squircle blur has no closed form\n(would need a 2D numeric quadrature over the implicit boundary); this is an accepted,\ndeliberate visual inconsistency (rounded shadow under a sharp squircle corner), not a bug.",
      "type": "object",
      "properties": {
        "blur_radius": {
          "type": "number",
          "format": "float"
        },
        "color": {
          "$ref": "#/$defs/OklabColor"
        },
        "inset": {
          "type": "boolean"
        },
        "offset_x": {
          "type": "number",
          "format": "float"
        },
        "offset_y": {
          "type": "number",
          "format": "float"
        },
        "spread_radius": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "offset_x",
        "offset_y",
        "blur_radius",
        "spread_radius",
        "color",
        "inset"
      ]
    },
    "Extent": {
      "description": "A box-model size dimension (mirrors taffy's `Dimension`). `fr` is deliberately absent -\nfractional-of-free-space is a container concern (`TrackSize::Fr` / flex grow), not a size a\nchild declares about itself.",
      "oneOf": [
        {
          "description": "Size to content / fill per flex-grow.",
          "type": "string",
          "const": "Auto"
        },
        {
          "description": "Fixed logical pixels.",
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "description": "Fraction of the parent's definite size (`0.5` == `50%`); resolves to `Auto` under an\nauto-sized parent (standard CSS percentage behavior).",
          "type": "object",
          "properties": {
            "Percent": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Percent"
          ]
        }
      ]
    },
    "FlexDir": {
      "description": "CSS `flex-direction`. Previously emitted as a bare `String` by Charter - now a real enum, so\nan invalid value fails to deserialize instead of silently mismatching.",
      "type": "string",
      "enum": [
        "Row",
        "Column",
        "RowReverse",
        "ColumnReverse"
      ]
    },
    "FlexWrapValue": {
      "type": "string",
      "enum": [
        "NoWrap",
        "Wrap",
        "WrapReverse"
      ]
    },
    "FontStyle": {
      "type": "string",
      "enum": [
        "Normal",
        "Italic",
        "Oblique"
      ]
    },
    "GridAutoFlow": {
      "description": "CSS `grid-auto-flow` (taffy's `GridAutoFlow`).",
      "type": "string",
      "enum": [
        "Row",
        "Column",
        "RowDense",
        "ColumnDense"
      ]
    },
    "GridLine": {
      "description": "A grid line reference for item placement. Not `Copy` - `NamedLine`/`NamedSpan` carry an\nowned name, unlike every other variant.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Line": {
              "type": "integer",
              "format": "int16",
              "maximum": 32767,
              "minimum": -32768
            }
          },
          "additionalProperties": false,
          "required": [
            "Line"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Span": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Span"
          ]
        },
        {
          "description": "A named line reference (`grid-column: sidebar-start`).",
          "type": "object",
          "properties": {
            "NamedLine": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "format": "int16",
                  "maximum": 32767,
                  "minimum": -32768
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "NamedLine"
          ]
        },
        {
          "description": "`span <name>` - spans until the nth line with this name (mirrors taffy's own\n`GridPlacement::NamedSpan`, which also carries a count).",
          "type": "object",
          "properties": {
            "NamedSpan": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "NamedSpan"
          ]
        }
      ]
    },
    "GridTemplateArea": {
      "description": "One named `grid-template-areas` region, resolved to numeric line coordinates (mirrors\ntaffy's own `GridTemplateArea`). `row_start`/`column_start` are 1-indexed grid lines;\n`row_end`/`column_end` are exclusive (one past the area's last line), matching\n`grid-row`/`grid-column`'s own end-line convention.",
      "type": "object",
      "properties": {
        "column_end": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "column_start": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "row_end": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "row_start": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "name",
        "row_start",
        "row_end",
        "column_start",
        "column_end"
      ]
    },
    "ImageSource": {
      "description": "Where an image's pixels come from. `Ref` names a previously-loaded image by id.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "None"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "Bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Ref": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Ref"
          ]
        }
      ]
    },
    "ImgData": {
      "description": "An image.",
      "type": "object",
      "properties": {
        "fit": {
          "description": "object-fit: `\"cover\"` | `\"contain\"` | `\"fill\"`.",
          "type": "string",
          "default": "cover"
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "object_position": {
          "description": "object-position as `(x, y)` fractions in `0..=1`.",
          "type": "array",
          "default": [
            0.5,
            0.5
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/ImageSource"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "source"
      ]
    },
    "JustifyValue": {
      "description": "CSS `justify-content` (taffy's `JustifyContent`) - adds the `Space*` distributions.",
      "type": "string",
      "enum": [
        "Start",
        "End",
        "FlexStart",
        "FlexEnd",
        "Center",
        "Stretch",
        "SpaceBetween",
        "SpaceEvenly",
        "SpaceAround"
      ]
    },
    "NodePosition": {
      "description": "CSS `position`, with `inset` folded into `Absolute` (only meaningful there). `Relative`\nparticipates in normal flow; `Absolute { x, y }` floats the node at a world-space offset.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Relative"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Absolute": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "format": "float"
                },
                "y": {
                  "type": "number",
                  "format": "float"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Absolute"
          ]
        }
      ]
    },
    "OklabColor": {
      "description": "Oklab color, the internal + wire representation (never sRGB). Authored as OKLCH, stored as\n`(l, a, b, alpha)`. `Default` is fully transparent (`alpha = 0`).",
      "type": "object",
      "properties": {
        "a": {
          "type": "number",
          "format": "float"
        },
        "alpha": {
          "type": "number",
          "format": "float"
        },
        "b": {
          "type": "number",
          "format": "float"
        },
        "l": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "l",
        "a",
        "b",
        "alpha"
      ]
    },
    "ShapeData": {
      "description": "A parametric vector shape (rect / ellipse / line / regular polygon / star), rendered via an\nanalytic SDF rather than a rasterized quad. Sized like `Box` (mirrors its width/height/min/max\nso Fixed/Hug/Fill resizing and flex/grid participation work identically); `hug` has no\nintrinsic content to hug, so it behaves like an explicit size. Fill/stroke are ordinary\nresolvable properties, never baked - same as every other paintable property in this dialect.",
      "type": "object",
      "properties": {
        "extra": {
          "$ref": "#/$defs/BoxExtra",
          "default": {
            "align_content": null,
            "align_items": null,
            "align_self": null,
            "flex_basis": null,
            "flex_grow": 0.0,
            "flex_shrink": null,
            "flex_wrap": "NoWrap",
            "gap": 0.0,
            "grid_auto_columns": [],
            "grid_auto_flow": "Row",
            "grid_auto_rows": [],
            "grid_column": [
              "Auto",
              "Auto"
            ],
            "grid_row": [
              "Auto",
              "Auto"
            ],
            "grid_template_areas": [],
            "grid_template_columns": [],
            "grid_template_rows": [],
            "justify_content": null,
            "justify_items": null,
            "justify_self": null,
            "margin": 0.0,
            "position": "Relative"
          }
        },
        "fill": {
          "$ref": "#/$defs/OklabColor"
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "kind": {
          "$ref": "#/$defs/ShapeKind"
        },
        "max_height": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "max_width": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "min_height": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "min_width": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "description": "0 = none, 1 = secondary, 2 = primary/active - same convention as `BoxData.selected`.",
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "stroke": {
          "$ref": "#/$defs/OklabColor"
        },
        "stroke_width": {
          "type": "number",
          "format": "float"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "kind",
        "width",
        "height",
        "fill",
        "stroke",
        "stroke_width",
        "opacity"
      ]
    },
    "ShapeKind": {
      "description": "The geometric kind of a `Shape` node, and its shape-specific parameters. Analytic/parametric\nonly for now (Phase 1) - a future `Path { .. }` variant (Phase 2, freeform) slots in here\nwithout breaking this tag, since the enum is already externally tagged per-variant.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Rect",
            "Ellipse",
            "Line"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Polygon": {
              "type": "object",
              "properties": {
                "sides": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "sides"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Polygon"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Star": {
              "type": "object",
              "properties": {
                "inner_ratio": {
                  "type": "number",
                  "format": "float"
                },
                "points": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "points",
                "inner_ratio"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Star"
          ]
        }
      ]
    },
    "TextAlign": {
      "description": "CSS `text-align` (LTR-relative; no bidi yet). `Left` is the wire default.",
      "type": "string",
      "enum": [
        "Left",
        "Center",
        "Right",
        "Justify"
      ]
    },
    "TextData": {
      "description": "A text run. Always declares `Auto` size; the renderer measures it during layout.",
      "type": "object",
      "properties": {
        "bg_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_width": {
          "type": "number",
          "format": "float"
        },
        "content": {
          "type": "string"
        },
        "corner_radius": {
          "type": "number",
          "format": "float"
        },
        "font_family": {
          "type": "string"
        },
        "font_size": {
          "type": "number",
          "format": "float"
        },
        "font_style": {
          "$ref": "#/$defs/FontStyle"
        },
        "font_weight": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "line_height": {
          "description": "Absolute px; `<= 0.0` means \"not provided\" (renderer falls back to a ratio).",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "padding": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "show_border": {
          "type": "boolean"
        },
        "squircle": {
          "description": "Same superellipse-corner toggle as `BoxData.squircle` - `Text` paints its own\nbackground/border/radius via the shared `extract_paint_props` helper.",
          "type": "boolean",
          "default": false
        },
        "text_align": {
          "$ref": "#/$defs/TextAlign",
          "default": "Left"
        },
        "text_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "text_decoration": {
          "$ref": "#/$defs/TextDecorationKind",
          "default": "None"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "padding",
        "bg_color",
        "show_border",
        "border_color",
        "border_width",
        "corner_radius",
        "opacity",
        "content",
        "font_size",
        "font_family",
        "font_weight",
        "font_style",
        "text_color"
      ]
    },
    "TextDecorationKind": {
      "description": "CSS `text-decoration`, single-choice (never underline AND line-through at once).",
      "type": "string",
      "enum": [
        "None",
        "Underline",
        "LineThrough"
      ]
    },
    "TrackMax": {
      "description": "The upper bound of a `minmax()` track - same shapes as `TrackMin` plus `Fr`.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto",
            "MinContent",
            "MaxContent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Percent": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Percent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Fr": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Fr"
          ]
        }
      ]
    },
    "TrackMin": {
      "description": "The lower bound of a `minmax()` track - CSS `<track-breadth>` minus `fr`, since a min bound\ncan never itself be a flex fraction.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto",
            "MinContent",
            "MaxContent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Percent": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Percent"
          ]
        }
      ]
    },
    "TrackSize": {
      "description": "A single CSS grid track size.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto",
            "MinContent",
            "MaxContent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Fr": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Fr"
          ]
        },
        {
          "description": "`repeat(auto-fit, minmax(<f32>px, 1fr))` - the one responsive-grid shape the Grid\narrangement needs, not a general `repeat()`.",
          "type": "object",
          "properties": {
            "AutoFit": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "AutoFit"
          ]
        },
        {
          "description": "`<f32>%` of the grid container's own definite size.",
          "type": "object",
          "properties": {
            "Percent": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Percent"
          ]
        },
        {
          "description": "`fit-content(<f32>px)`.",
          "type": "object",
          "properties": {
            "FitContent": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "FitContent"
          ]
        },
        {
          "description": "`repeat(auto-fill, minmax(<f32>px, 1fr))` - `AutoFit`'s sibling: fills as many tracks as\nfit without collapsing/stretching empty ones into existing content, CSS's real\nauto-fit-vs-auto-fill distinction.",
          "type": "object",
          "properties": {
            "AutoFill": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "AutoFill"
          ]
        },
        {
          "description": "Arbitrary `minmax(<min>, <max>)`, for a shape none of the fixed variants above cover.",
          "type": "object",
          "properties": {
            "MinMax": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/TrackMin"
                },
                {
                  "$ref": "#/$defs/TrackMax"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "MinMax"
          ]
        }
      ]
    }
  }
}
