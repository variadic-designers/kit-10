{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WireSchemaRoot",
  "type": "object",
  "properties": {
    "box_node": {
      "$ref": "#/$defs/BoxData"
    },
    "img_node": {
      "$ref": "#/$defs/ImgData"
    },
    "text_node": {
      "$ref": "#/$defs/TextData"
    }
  },
  "required": [
    "box_node",
    "text_node",
    "img_node"
  ],
  "$defs": {
    "AlignValue": {
      "description": "CSS `align-items` / `align-self` (taffy's `AlignItems`).",
      "type": "string",
      "enum": [
        "Start",
        "End",
        "FlexStart",
        "FlexEnd",
        "Center",
        "Baseline",
        "Stretch"
      ]
    },
    "BoxData": {
      "description": "A box — a pure container. It never renders inline text; nest a `Text` child for that.",
      "type": "object",
      "properties": {
        "bg_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_width": {
          "type": "number",
          "format": "float"
        },
        "corner_radius": {
          "type": "number",
          "format": "float"
        },
        "extra": {
          "$ref": "#/$defs/BoxExtra",
          "default": {
            "align_items": null,
            "align_self": null,
            "flex_basis": null,
            "flex_grow": 0.0,
            "flex_shrink": null,
            "flex_wrap": "NoWrap",
            "gap": 0.0,
            "grid_auto_columns": [],
            "grid_auto_rows": [],
            "grid_column": [
              "Auto",
              "Auto"
            ],
            "grid_row": [
              "Auto",
              "Auto"
            ],
            "grid_template_columns": [],
            "grid_template_rows": [],
            "justify_content": null,
            "margin": 0.0,
            "position": "Relative"
          }
        },
        "flex_direction": {
          "$ref": "#/$defs/FlexDir"
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "description": "Independent from `selected`.",
          "type": "boolean",
          "default": false
        },
        "max_height": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "max_width": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "min_height": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "min_width": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "padding": {
          "description": "`[top, right, bottom, left]`.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "parent_id": {
          "description": "Index into the `Vec<UiNode>` of this node's parent; `None` = root.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "description": "0 = none, 1 = secondary, 2 = primary/active. The renderer owns how it's drawn — it must\nNOT overload `border_*` to signal selection.",
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoxShadow"
            },
            {
              "type": "null"
            }
          ]
        },
        "show_border": {
          "type": "boolean"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "padding",
        "bg_color",
        "flex_direction",
        "show_border",
        "border_color",
        "border_width",
        "corner_radius",
        "opacity"
      ]
    },
    "BoxExtra": {
      "description": "Extended flex/grid layout properties, grouped so `BoxData` needn't name every field. Every\nfield is optional — an absent `extra` is all-defaults.",
      "type": "object",
      "properties": {
        "align_items": {
          "description": "Cross-axis alignment of children (`align-items`). `None` = taffy default (Stretch).",
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "align_self": {
          "description": "Per-child `align-self` override.",
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flex_basis": {
          "description": "`flex-basis`. `None` = `auto`; a \"Fill\" item wants `Px(0)` for a pure share of free space.",
          "anyOf": [
            {
              "$ref": "#/$defs/Extent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flex_grow": {
          "description": "`flex-grow`. 0 = don't grow.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "flex_shrink": {
          "description": "`flex-shrink`. `None` = taffy default (1.0).",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "flex_wrap": {
          "description": "`flex-wrap`.",
          "$ref": "#/$defs/FlexWrapValue",
          "default": "NoWrap"
        },
        "gap": {
          "description": "Uniform gap between children (`gap`), flex and grid.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "grid_auto_columns": {
          "description": "`grid-auto-columns`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_auto_rows": {
          "description": "`grid-auto-rows`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_column": {
          "description": "Item column placement `(start, end)`.",
          "type": "array",
          "default": [
            "Auto",
            "Auto"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GridLine"
            },
            {
              "$ref": "#/$defs/GridLine"
            }
          ]
        },
        "grid_row": {
          "description": "Item row placement `(start, end)`.",
          "type": "array",
          "default": [
            "Auto",
            "Auto"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GridLine"
            },
            {
              "$ref": "#/$defs/GridLine"
            }
          ]
        },
        "grid_template_columns": {
          "description": "`grid-template-columns`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_template_rows": {
          "description": "`grid-template-rows`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "justify_content": {
          "description": "Main-axis distribution (`justify-content`). `None` = taffy default (Start).",
          "anyOf": [
            {
              "$ref": "#/$defs/JustifyValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "margin": {
          "description": "Uniform `margin` (all four sides).",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "position": {
          "description": "`position` — flow (`Relative`) vs. floated (`Absolute { x, y }`).",
          "$ref": "#/$defs/NodePosition",
          "default": "Relative"
        }
      }
    },
    "BoxShadow": {
      "description": "A drop shadow (`box-shadow`).",
      "type": "object",
      "properties": {
        "blur_radius": {
          "type": "number",
          "format": "float"
        },
        "color": {
          "$ref": "#/$defs/OklabColor"
        },
        "inset": {
          "type": "boolean"
        },
        "offset_x": {
          "type": "number",
          "format": "float"
        },
        "offset_y": {
          "type": "number",
          "format": "float"
        },
        "spread_radius": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "offset_x",
        "offset_y",
        "blur_radius",
        "spread_radius",
        "color",
        "inset"
      ]
    },
    "Extent": {
      "description": "A box-model size dimension (mirrors taffy's `Dimension`). `fr` is deliberately absent —\nfractional-of-free-space is a container concern (`TrackSize::Fr` / flex grow), not a size a\nchild declares about itself.",
      "oneOf": [
        {
          "description": "Size to content / fill per flex-grow.",
          "type": "string",
          "const": "Auto"
        },
        {
          "description": "Fixed logical pixels.",
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "description": "Fraction of the parent's definite size (`0.5` == `50%`); resolves to `Auto` under an\nauto-sized parent (standard CSS percentage behavior).",
          "type": "object",
          "properties": {
            "Percent": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Percent"
          ]
        }
      ]
    },
    "FlexDir": {
      "description": "CSS `flex-direction`. Previously emitted as a bare `String` by Charter — now a real enum, so\nan invalid value fails to deserialize instead of silently mismatching.",
      "type": "string",
      "enum": [
        "Row",
        "Column",
        "RowReverse",
        "ColumnReverse"
      ]
    },
    "FlexWrapValue": {
      "type": "string",
      "enum": [
        "NoWrap",
        "Wrap",
        "WrapReverse"
      ]
    },
    "FontStyle": {
      "type": "string",
      "enum": [
        "Normal",
        "Italic",
        "Oblique"
      ]
    },
    "GridLine": {
      "description": "A grid line reference for item placement.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Line": {
              "type": "integer",
              "format": "int16",
              "maximum": 32767,
              "minimum": -32768
            }
          },
          "additionalProperties": false,
          "required": [
            "Line"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Span": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Span"
          ]
        }
      ]
    },
    "ImageSource": {
      "description": "Where an image's pixels come from. `Ref` names a previously-loaded image by id.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "None"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "Bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Ref": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Ref"
          ]
        }
      ]
    },
    "ImgData": {
      "description": "An image.",
      "type": "object",
      "properties": {
        "fit": {
          "description": "object-fit: `\"cover\"` | `\"contain\"` | `\"fill\"`.",
          "type": "string",
          "default": "cover"
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "object_position": {
          "description": "object-position as `(x, y)` fractions in `0..=1`.",
          "type": "array",
          "default": [
            0.5,
            0.5
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/ImageSource"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "source"
      ]
    },
    "JustifyValue": {
      "description": "CSS `justify-content` (taffy's `JustifyContent`) — adds the `Space*` distributions.",
      "type": "string",
      "enum": [
        "Start",
        "End",
        "FlexStart",
        "FlexEnd",
        "Center",
        "Stretch",
        "SpaceBetween",
        "SpaceEvenly",
        "SpaceAround"
      ]
    },
    "NodePosition": {
      "description": "CSS `position`, with `inset` folded into `Absolute` (only meaningful there). `Relative`\nparticipates in normal flow; `Absolute { x, y }` floats the node at a world-space offset.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Relative"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Absolute": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "format": "float"
                },
                "y": {
                  "type": "number",
                  "format": "float"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Absolute"
          ]
        }
      ]
    },
    "OklabColor": {
      "description": "Oklab color, the internal + wire representation (never sRGB). Authored as OKLCH, stored as\n`(l, a, b, alpha)`. `Default` is fully transparent (`alpha = 0`).",
      "type": "object",
      "properties": {
        "a": {
          "type": "number",
          "format": "float"
        },
        "alpha": {
          "type": "number",
          "format": "float"
        },
        "b": {
          "type": "number",
          "format": "float"
        },
        "l": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "l",
        "a",
        "b",
        "alpha"
      ]
    },
    "TextAlign": {
      "description": "CSS `text-align` (LTR-relative; no bidi yet). `Left` is the wire default.",
      "type": "string",
      "enum": [
        "Left",
        "Center",
        "Right",
        "Justify"
      ]
    },
    "TextData": {
      "description": "A text run. Always declares `Auto` size; the renderer measures it during layout.",
      "type": "object",
      "properties": {
        "bg_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_width": {
          "type": "number",
          "format": "float"
        },
        "content": {
          "type": "string"
        },
        "corner_radius": {
          "type": "number",
          "format": "float"
        },
        "font_family": {
          "type": "string"
        },
        "font_size": {
          "type": "number",
          "format": "float"
        },
        "font_style": {
          "$ref": "#/$defs/FontStyle"
        },
        "font_weight": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "line_height": {
          "description": "Absolute px; `<= 0.0` means \"not provided\" (renderer falls back to a ratio).",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "padding": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "show_border": {
          "type": "boolean"
        },
        "text_align": {
          "$ref": "#/$defs/TextAlign",
          "default": "Left"
        },
        "text_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "text_decoration": {
          "$ref": "#/$defs/TextDecorationKind",
          "default": "None"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "padding",
        "bg_color",
        "show_border",
        "border_color",
        "border_width",
        "corner_radius",
        "opacity",
        "content",
        "font_size",
        "font_family",
        "font_weight",
        "font_style",
        "text_color"
      ]
    },
    "TextDecorationKind": {
      "description": "CSS `text-decoration`, single-choice (never underline AND line-through at once).",
      "type": "string",
      "enum": [
        "None",
        "Underline",
        "LineThrough"
      ]
    },
    "TrackSize": {
      "description": "A single CSS grid track size.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto",
            "MinContent",
            "MaxContent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Fr": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Fr"
          ]
        },
        {
          "description": "`repeat(auto-fit, minmax(<f32>px, 1fr))` — the one responsive-grid shape the Grid\narrangement needs, not a general `repeat()`.",
          "type": "object",
          "properties": {
            "AutoFit": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "AutoFit"
          ]
        }
      ]
    }
  }
}
