{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WireSchemaRoot",
  "type": "object",
  "properties": {
    "box_node": {
      "$ref": "#/$defs/BoxData"
    },
    "img_node": {
      "$ref": "#/$defs/ImgData"
    },
    "text_node": {
      "$ref": "#/$defs/TextData"
    }
  },
  "required": [
    "box_node",
    "text_node",
    "img_node"
  ],
  "$defs": {
    "AlignValue": {
      "type": "string",
      "enum": [
        "Start",
        "End",
        "FlexStart",
        "FlexEnd",
        "Center",
        "Baseline",
        "Stretch"
      ]
    },
    "BoxData": {
      "type": "object",
      "properties": {
        "bg_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_width": {
          "type": "number",
          "format": "float"
        },
        "corner_radius": {
          "type": "number",
          "format": "float"
        },
        "extra": {
          "$ref": "#/$defs/BoxExtra",
          "default": {
            "align_items": null,
            "align_self": null,
            "flex_basis": null,
            "flex_grow": 0.0,
            "flex_shrink": null,
            "flex_wrap": "NoWrap",
            "gap": 0.0,
            "grid_auto_columns": [],
            "grid_auto_rows": [],
            "grid_column": [
              "Auto",
              "Auto"
            ],
            "grid_row": [
              "Auto",
              "Auto"
            ],
            "grid_template_columns": [],
            "grid_template_rows": [],
            "justify_content": null,
            "margin": 0.0,
            "position": "Relative"
          }
        },
        "flex_direction": {
          "type": "string"
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "max_height": {
          "$ref": "#/$defs/Extent"
        },
        "max_width": {
          "$ref": "#/$defs/Extent"
        },
        "min_height": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "min_width": {
          "$ref": "#/$defs/Extent",
          "default": "Auto"
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "padding": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoxShadow"
            },
            {
              "type": "null"
            }
          ]
        },
        "show_border": {
          "type": "boolean"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "max_width",
        "max_height",
        "padding",
        "bg_color",
        "flex_direction",
        "show_border",
        "border_color",
        "border_width",
        "corner_radius",
        "opacity"
      ]
    },
    "BoxExtra": {
      "type": "object",
      "properties": {
        "align_items": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "align_self": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlignValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flex_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flex_grow": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "flex_shrink": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "flex_wrap": {
          "$ref": "#/$defs/FlexWrapValue",
          "default": "NoWrap"
        },
        "gap": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "grid_auto_columns": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_auto_rows": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_column": {
          "type": "array",
          "default": [
            "Auto",
            "Auto"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GridLine"
            },
            {
              "$ref": "#/$defs/GridLine"
            }
          ]
        },
        "grid_row": {
          "type": "array",
          "default": [
            "Auto",
            "Auto"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GridLine"
            },
            {
              "$ref": "#/$defs/GridLine"
            }
          ]
        },
        "grid_template_columns": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "grid_template_rows": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "justify_content": {
          "anyOf": [
            {
              "$ref": "#/$defs/JustifyValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "margin": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "position": {
          "$ref": "#/$defs/NodePosition",
          "default": "Relative"
        }
      }
    },
    "BoxShadow": {
      "type": "object",
      "properties": {
        "blur_radius": {
          "type": "number",
          "format": "float"
        },
        "color": {
          "$ref": "#/$defs/OklabColor"
        },
        "inset": {
          "type": "boolean"
        },
        "offset_x": {
          "type": "number",
          "format": "float"
        },
        "offset_y": {
          "type": "number",
          "format": "float"
        },
        "spread_radius": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "offset_x",
        "offset_y",
        "blur_radius",
        "spread_radius",
        "color",
        "inset"
      ]
    },
    "Extent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Percent": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Percent"
          ]
        }
      ]
    },
    "FlexWrapValue": {
      "type": "string",
      "enum": [
        "NoWrap",
        "Wrap",
        "WrapReverse"
      ]
    },
    "GridLine": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Line": {
              "type": "integer",
              "format": "int16",
              "maximum": 32767,
              "minimum": -32768
            }
          },
          "additionalProperties": false,
          "required": [
            "Line"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Span": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "Span"
          ]
        }
      ]
    },
    "ImageSource": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "None"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Url": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "Bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Ref": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Ref"
          ]
        }
      ]
    },
    "ImgData": {
      "type": "object",
      "properties": {
        "fit": {
          "type": "string"
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "object_position": {
          "type": "array",
          "default": [
            0.5,
            0.5
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/ImageSource"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "source",
        "fit"
      ]
    },
    "JustifyValue": {
      "type": "string",
      "enum": [
        "Start",
        "End",
        "FlexStart",
        "FlexEnd",
        "Center",
        "Stretch",
        "SpaceBetween",
        "SpaceEvenly",
        "SpaceAround"
      ]
    },
    "NodePosition": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Relative"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Absolute": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "format": "float"
                },
                "y": {
                  "type": "number",
                  "format": "float"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Absolute"
          ]
        }
      ]
    },
    "OklabColor": {
      "type": "object",
      "properties": {
        "a": {
          "type": "number",
          "format": "float"
        },
        "alpha": {
          "type": "number",
          "format": "float"
        },
        "b": {
          "type": "number",
          "format": "float"
        },
        "l": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "l",
        "a",
        "b",
        "alpha"
      ]
    },
    "TextData": {
      "type": "object",
      "properties": {
        "bg_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "border_width": {
          "type": "number",
          "format": "float"
        },
        "content": {
          "type": "string"
        },
        "corner_radius": {
          "type": "number",
          "format": "float"
        },
        "font_family": {
          "type": "string"
        },
        "font_size": {
          "type": "number",
          "format": "float"
        },
        "font_style": {
          "type": "string"
        },
        "font_weight": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "height": {
          "$ref": "#/$defs/Extent"
        },
        "hovered": {
          "type": "boolean",
          "default": false
        },
        "line_height": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "padding": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "parent_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "format": "uint8",
          "default": 0,
          "maximum": 255,
          "minimum": 0
        },
        "show_border": {
          "type": "boolean"
        },
        "text_align": {
          "type": "string",
          "default": "Left"
        },
        "text_color": {
          "$ref": "#/$defs/OklabColor"
        },
        "text_decoration": {
          "type": "string",
          "default": "None"
        },
        "width": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "width",
        "height",
        "padding",
        "bg_color",
        "show_border",
        "border_color",
        "border_width",
        "corner_radius",
        "opacity",
        "content",
        "font_size",
        "font_family",
        "font_weight",
        "font_style",
        "text_color"
      ]
    },
    "TrackSize": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Auto",
            "MinContent",
            "MaxContent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Px": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Px"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Fr": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "Fr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "AutoFit": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "AutoFit"
          ]
        }
      ]
    }
  }
}
