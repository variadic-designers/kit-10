{
	"name": "manager",
	"type": "module",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"start": "node ./dist/index.js",
		"test": "vitest",
		"bench": "vitest bench --run src/resolve/resolve.bench.ts",
		"dev": "concurrently \"tsc --watch\" \"pglite-server --db=./pgdata --run 'nodemon ./dist/index.js' --include-database-url\""
	},
	"main": "./src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts"
		}
	},
	"keywords": [],
	"author": "",
	"license": "All Rights Reserved",
	"packageManager": "pnpm@10.26.1",
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@electric-sql/pglite-pg_uuidv7": "^0.0.5",
		"@electric-sql/pglite-socket": "^0.2.7",
		"@soapbox/kysely-pglite": "jsr:^1.1.0",
		"@types/node": "^25.3.5",
		"concurrently": "^9.2.1",
		"kysely": "^0.28.16",
		"nodemon": "^3.1.14",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
